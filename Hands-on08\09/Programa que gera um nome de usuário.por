programa {
  funcao inicio() {
    /* Programa que gera um nome de usuário utilizando o nome e sobrenome digitados.
       Variável 1 = nome (variável cadeia escolhida pelo usuário)
       Variável 2 = sobrenome (variável cadeia escolhida pelo usuário)
    */
    cadeia nome, sobrenome
     escreva ("Insira seu primeiro nome.\n")
     leia (nome)
     escreva ("Insira seu sobrenome.\n")
     leia (sobrenome)
     escreva ("Seu usuário fica da seguinte forma: ",nome,"_",sobrenome, ".\n")
  }
}
